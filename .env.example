# Configuración de Groq (Asistente Chatbot)
# El sistema soporta múltiples keys para rotación automática y evitar límites de crédito o tasa
VITE_GROQ_API_KEY_1=your_groq_api_key_1_here
VITE_GROQ_API_KEY_2=your_groq_api_key_2_here
VITE_GROQ_API_KEY_3=your_groq_api_key_3_here
VITE_GROQ_MODEL=llama-3.1-8b-instant
VITE_GROQ_MAX_COMPLETION_TOKENS=250
VITE_GROQ_TEMPERATURE=0.25
VITE_GEMINI_API_KEY_1=your_gemini_api_key_1_here
VITE_GEMINI_API_KEY_2=your_gemini_api_key_2_here
VITE_GEMINI_API_KEY_3=your_gemini_api_key_3_here
VITE_GEMINI_API_KEY_4=your_gemini_api_key_4_here
VITE_GEMINI_API_KEY_5=your_gemini_api_key_5_here
VITE_GEMINI_MODEL=gemini-2.5-flash
