  totalSensors,
  activeAlertsCount,
}) => {
  return (
    <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div className="rounded-[14px] border border-white/8 bg-emerald-400/10 p-5 shadow-lg backdrop-blur-md">
