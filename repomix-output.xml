import { Application } from '@splinetool/runtime';

const canvas = document.getElementById('canvas3d');
const app = new Application(canvas);




const onLoad = () => {



}


app.start_promise = app.start;
app.start = function (data) {
    return app.start_promise.call(app, data).then(() => {
        console.log("Spline loaded locally! Hiding texts...");
        app.getObjects().forEach(obj => {
            console.log("Found Object:", obj.name, obj.type);
            if (obj.type === 'Text' || obj.type === 'TextGeometry' || (obj.name && obj.name.toLowerCase().includes('text'))) {
                obj.visible = false;
                console.log("Hidden object:", obj.name);
            }
        });
