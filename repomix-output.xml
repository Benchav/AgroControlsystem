    doc.setFontSize(7);
    doc.setTextColor(71, 85, 105);
    doc.text('Agro Control System — Reporte Confidencial', 14, pageH - 3.5);
    doc.text(`Página ${i} de ${totalPages}`, pageW - 14, pageH - 3.5, { align: 'right' });
